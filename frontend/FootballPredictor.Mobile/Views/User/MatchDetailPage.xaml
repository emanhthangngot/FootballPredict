<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FootballPredictor.Mobile.Views.User.MatchDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">
    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="Match Analytics" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
        <Label Text="Home 46%   Draw 27%   Away 27%" TextColor="{StaticResource AccentBlue}" />
        <Label Text="Analytics and explainable AI. Not betting advice." TextColor="{StaticResource TextMuted}" />
    </VerticalStackLayout>
</ContentPage>
